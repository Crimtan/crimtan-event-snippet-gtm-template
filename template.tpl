scenarios:
- name: Purchase - full payload, types converted, currency upper-cased
  code: |-
    let queueName;
    let pushed;
    mock('createQueue', function(name) {
      queueName = name;
      return function(obj) { pushed = obj; };
    });
    runCode({
      event: 'purchase',
      purchase__item_name: 'Blue Shirt, Red Hat ,Socks',
      purchase__item_sku: 'SKU1,SKU2,SKU3',
      purchase__item_quantity: '1, 2,3',
      purchase__revenue: '246.90',
      purchase__transaction_id: 'TXN-1',
      purchase__currency: 'gbp'
    });
    assertThat(queueName).isEqualTo('consentag_data');
    assertApi('gtmOnSuccess').wasCalled();
    assertThat(pushed).isEqualTo({
      event: 'purchase',
      item_name: ['Blue Shirt', 'Red Hat', 'Socks'],
      item_sku: ['SKU1', 'SKU2', 'SKU3'],
      item_quantity: [1, 2, 3],
      revenue: 246.9,
      transaction_id: 'TXN-1',
      currency: 'GBP'
    });
- name: Purchase - arrays from data layer variables are kept and converted
