___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// =====================================================================
// Crimtan Event Snippet – Code tab
// Pushes a Crimtan standard event to the consenTag data layer
// (window.consentag_data). Field names follow the Crimtan Standard
// Snippets spec; template fields are named <event>__<parameter>.
// =====================================================================

const createQueue = require('createQueue');
const getType = require('getType');
const logToConsole = require('logToConsole');
const makeNumber = require('makeNumber');
const makeString = require('makeString');
const Object = require('Object');

// ---------------------------------------------------------------------
// Value converters
// ---------------------------------------------------------------------

// Arrays pass through; strings are split on commas, trimmed and
// stripped of empty items; anything else becomes a one-item list.
const toList = (value) => {
  const type = getType(value);
  if (type === 'array') return value;
  if (type === 'string') {
    return value.split(',')
      .map((item) => item.trim())
      .filter((item) => item !== '');
  }
  return [value];
};

const text = (value) => makeString(value);
const number = (value) => makeNumber(value);
const currency = (value) => makeString(value).toUpperCase();
const textList = (value) => toList(value).map(text);
const numberList = (value) => toList(value).map(number);

// ---------------------------------------------------------------------
// Parameters for each Crimtan standard event
// ---------------------------------------------------------------------
const SPEC = {
  purchase: {
    item_name: textList,
    item_sku: textList,
    item_quantity: numberList,
    revenue: number,
    transaction_id: text,
    currency: currency
  },
  view_item: {
    item_name: text,
    item_sku: text,
    item_price: number,
    currency: currency,
    item_category: text,
    item_category1: text,
    item_category2: text
  },
  add_to_cart: {
    item_name: text,
    item_sku: text,
    item_quantity: number,
    value: number,
    currency: currency
  },
  begin_checkout: {
    item_name: textList,
    item_sku: textList,
    item_quantity: numberList,
    value: number,
    currency: currency
  },
  checkout_progress: {
    item_name: textList,
    item_sku: textList,
    item_quantity: numberList,
    step_number: number,
    step_name: text,
    value: number,
    currency: currency
  },
  view_content: {
    content_type: text,
    content_description: text,
    content_ids: textList
  },
  generate_lead: {
    lead_source: text,
    value: number,
    currency: currency
  },
  contact: {
    enquiry_type: text,
    content_id: textList
  },
  search: {
    search_term: text
  }
};

const isEmpty = (value) => value === undefined || value === null || value === '';

// ---------------------------------------------------------------------
// Build and push the payload
// ---------------------------------------------------------------------
const eventName = data.event;
const params = SPEC[eventName] || {};
const payload = { event: eventName };

Object.keys(params).forEach((name) => {
  const value = data[eventName + '__' + name];
  if (!isEmpty(value)) {
    payload[name] = params[name](value);
  }
});

createQueue('consentag_data')(payload);
logToConsole('Crimtan event snippet pushed to consentag_data:', payload);

data.gtmOnSuccess();


